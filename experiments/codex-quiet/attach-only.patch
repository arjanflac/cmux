@@ -0,0 +1,98 @@
+//! A deliberately narrow entrypoint. The cmux wrapper handles stock fallback
+//! before calling this binary. Errors here never replay input through stock.
+use clap::Parser;
+use codex_app_server_client::{RemoteAppServerClient, RemoteAppServerConnectArgs, RemoteAppServerEndpoint};
+use codex_arg0::Arg0DispatchPaths;
+use codex_config::LoaderOverrides;
+use codex_tui::{Cli, ExitReason};
+use std::io::IsTerminal;
+use std::path::PathBuf;
+
+fn parse(arguments: &[String]) -> anyhow::Result<Cli> {
+    let mut rest = arguments;
+    let mut session = None;
+    let resume = rest.first().is_some_and(|a| a == "resume");
+    if resume {
+        rest = &rest[1..];
+        if rest.first().is_some_and(|a| !a.starts_with('-')) {
+            let value = &rest[0];
+            anyhow::ensure!(uuid::Uuid::parse_str(value).is_ok(), "only explicit resume UUIDs are supported");
+            session = Some(value.clone());
+            rest = &rest[1..];
+        }
+    }
+    let mut index = 0;
+    while index < rest.len() {
+        match rest[index].as_str() {
+            "-m" | "--model" | "-C" | "--cd" | "-s" | "--sandbox" | "-a" | "--ask-for-approval" => {
+                index += 1;
+                anyhow::ensure!(index < rest.len() && !rest[index].starts_with('-'), "missing option value");
+            }
+            "--dangerously-bypass-approvals-and-sandbox" => (),
+            _ => anyhow::bail!("unsupported invocation; use stock Codex"),
+        }
+        index += 1;
+    }
+    let mut cli = Cli::try_parse_from(std::iter::once("codex".to_string()).chain(rest.iter().cloned()))?;
+    cli.resume_picker = resume && session.is_none();
+    cli.resume_session_id = session;
+    Ok(cli)
+}
+
+async fn endpoint() -> anyhow::Result<RemoteAppServerEndpoint> {
+    let home = codex_core::config::find_codex_home()?;
+    let advertised = codex_app_server_client::app_server_control_socket_path(&home)?;
+    let socket_path = codex_app_server_client::verified_local_daemon_socket(advertised.as_path())?
+        .ok_or_else(|| anyhow::anyhow!("no verified stock daemon socket"))?;
+    let (endpoint, launch_endpoint) = codex_tui::cmux_quiet::attachment_endpoints(advertised, socket_path);
+    let client = RemoteAppServerClient::connect(RemoteAppServerConnectArgs {
+        endpoint: endpoint.clone(), client_name: "codex-tui".to_string(),
+        client_version: env!("CARGO_PKG_VERSION").to_string(), experimental_api: true,
+        mcp_server_openai_form_elicitation: false, opt_out_notification_methods: vec![], channel_capacity: 32,
+    }).await?;
+    codex_tui::cmux_quiet::require_server_version(client.server_version())?;
+    // Dropping this client closes only its transport. No daemon lifecycle RPC.
+    drop(client);
+    // Preserve the advertised default alias for upstream's local-daemon
+    // classification. Startup verifies it again and pins the protected endpoint.
+    Ok(launch_endpoint)
+}
+
+#[tokio::main]
+async fn main() -> anyhow::Result<()> {
+    codex_build_info::initialize!();
+    let mut arguments: Vec<String> = std::env::args().skip(1).collect();
+    let check = arguments.first().is_some_and(|a| a == "--cmux-check");
+    if check { arguments.remove(0); }
+    let cli = parse(&arguments)?;
+    let stock = PathBuf::from(std::env::var_os("CMUX_QUIET_STOCK_CODEX").ok_or_else(|| anyhow::anyhow!("missing stock helper path"))?);
+    anyhow::ensure!(stock.is_absolute() && stock.is_file(), "invalid stock helper path");
+    anyhow::ensure!(std::fs::canonicalize(&stock)? != std::fs::canonicalize(std::env::current_exe()?)?, "quiet frontend cannot be its own helper");
+    if !check { anyhow::ensure!(std::io::stdin().is_terminal() && std::io::stdout().is_terminal(), "interactive terminal required"); }
+    let endpoint = tokio::time::timeout(std::time::Duration::from_secs(3), endpoint()).await??;
+    if check { return Ok(()); }
+    let paths = Arg0DispatchPaths { codex_self_exe: Some(stock), ..Default::default() };
+    let exit = Box::pin(codex_tui::run_main(cli, paths, LoaderOverrides::default(), Some(endpoint))).await?;
+    for line in exit.format_exit_messages(false) { println!("{line}"); }
+    if let ExitReason::Fatal(message) = exit.exit_reason { anyhow::bail!(message); }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn args(values: &[&str]) -> Vec<String> { values.iter().map(|s| s.to_string()).collect() }
+    #[test]
+    fn cmux_attach_accepts_narrow_root_and_resume_lane() {
+        assert!(parse(&[]).is_ok());
+        assert!(parse(&args(&["resume"])).unwrap().resume_picker);
+        let cli = parse(&args(&["resume", "01a176fc-d044-7e62-92bb-de6c5c50c0d1", "--model", "gpt-6-luna"])).unwrap();
+        assert_eq!(cli.resume_session_id.as_deref(), Some("01a176fc-d044-7e62-92bb-de6c5c50c0d1"));
+    }
+    #[test]
+    fn cmux_attach_rejects_commands_overrides_and_worktrees_before_connecting() {
+        for values in [&["exec"][..], &["resume", "--last"], &["--no-daemon"], &["--remote", "unix://other"], &["--worktree"], &["-c", "x=y"], &["fork"], &["update"], &["hello"], &["--model"]] {
+            assert!(parse(&args(values)).is_err(), "{values:?}");
+        }
+    }
+}
