@@ -0,0 +1,58 @@
+//! Boundaries for cmux's maintained, attach-only presentation binary.
+
+/// Probe the verified private endpoint, then launch through the advertised
+/// default alias so upstream startup preserves local project/cwd semantics.
+pub fn attachment_endpoints(
+    advertised: codex_utils_absolute_path::AbsolutePathBuf,
+    protected: codex_utils_absolute_path::AbsolutePathBuf,
+) -> (codex_app_server_client::RemoteAppServerEndpoint, codex_app_server_client::RemoteAppServerEndpoint) {
+    use codex_app_server_client::RemoteAppServerEndpoint;
+    (RemoteAppServerEndpoint::UnixSocket { socket_path: protected },
+     RemoteAppServerEndpoint::UnixSocket { socket_path: advertised })
+}
+
+pub fn require_embedded_allowed() -> std::io::Result<()> {
+    if cfg!(feature = "cmux-quiet") {
+        return Err(std::io::Error::other("cmux quiet frontend cannot start an embedded app server"));
+    }
+    Ok(())
+}
+
+pub fn require_server_version(version: Option<&str>) -> std::io::Result<()> {
+    if cfg!(feature = "cmux-quiet") && version != Some(env!("CARGO_PKG_VERSION")) {
+        return Err(std::io::Error::other("cmux quiet frontend requires its exact stock daemon version"));
+    }
+    Ok(())
+}
+
+#[cfg(all(test, feature = "cmux-quiet"))]
+mod tests {
+    use super::*;
+    #[test]
+    fn cmux_attach_rejects_embedded_backend() {
+        assert!(require_embedded_allowed().is_err());
+    }
+    #[test]
+    fn cmux_attach_local_target_preserves_workspace_semantics() {
+        let protected = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(std::path::PathBuf::from("/tmp/cmux-protected.sock")).unwrap();
+        let advertised = codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(std::path::PathBuf::from("/tmp/cmux-advertised.sock")).unwrap();
+        let (probe, launch) = attachment_endpoints(advertised.clone(), protected.clone());
+        assert!(matches!(&probe, codex_app_server_client::RemoteAppServerEndpoint::UnixSocket { socket_path } if socket_path == &protected));
+        assert!(matches!(&launch, codex_app_server_client::RemoteAppServerEndpoint::UnixSocket { socket_path } if socket_path == &advertised));
+        // After launch recognizes and verifies that alias, the actual resolver
+        // must retain local semantics without an embedded fallback.
+        let target = crate::app_server_target_for_launch(
+            Some(codex_app_server_client::RemoteAppServerEndpoint::UnixSocket { socket_path: protected.clone() }),
+            Some(protected), false, false, None,
+        ).unwrap();
+        assert!(matches!(&target, crate::AppServerTarget::LocalDaemon { allow_embedded_fallback: false, .. }));
+        assert!(!target.uses_remote_workspace());
+    }
+    #[test]
+    fn cmux_attach_requires_exact_server_version() {
+        assert!(require_server_version(Some(env!("CARGO_PKG_VERSION"))).is_ok());
+        for version in [None, Some("0.163.0"), Some("0.164.1"), Some("unknown")] {
+            assert!(require_server_version(version).is_err());
+        }
+    }
+}
