+/// Summaries contain a typed status and name, never tool arguments or result text.
+pub(crate) fn quiet_tool_line(status: &str, name: &str, width: u16) -> HyperlinkLine {
+    let name: String = name
+        .chars()
+        .map(|ch| if ch.is_control() { ' ' } else { ch })
+        .collect();
+    clipped_line(Line::from(format!("• {status} {name}")), width)
+}
