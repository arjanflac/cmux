 impl HistoryCell for ExecCell {
+    fn quiet_fullscreen_line(&self, width: u16) -> Option<HyperlinkLine> {
+        // User-shell commands and terminal interaction records retain their existing display.
+        if self.group.calls.is_empty()
+            || self.iter_calls().any(|call| {
+                !matches!(
+                    call.source,
+                    ExecCommandSource::Agent | ExecCommandSource::UnifiedExecStartup
+                )
+            })
+        {
+            return None;
+        }
+        let nonzero: Vec<_> = self
+            .iter_calls()
+            .filter(|call| call.duration.is_some())
+            .filter_map(|call| call.output.as_ref())
+            .filter(|output| output.exit_code != 0)
+            .collect();
+        let mut status = if self.is_active() {
+            "Running"
+        } else {
+            "Completed"
+        }
+        .to_owned();
+        if self.group.calls.len() == 1 {
+            if let Some(output) = nonzero.first() {
+                status.push_str(&format!(" (exit {})", output.exit_code));
+            }
+        } else if !nonzero.is_empty() {
+            status.push_str(&format!(" ({} nonzero exits)", nonzero.len()));
+        }
+        let name = if self.group.calls.len() == 1 {
+            if self.is_exploring_cell() {
+                "exploration".to_owned()
+            } else {
+                "command".to_owned()
+            }
+        } else {
+            format!("{} commands", self.group.calls.len())
+        };
+        Some(crate::history_cell::activity_preview::quiet_tool_line(
+            &status, &name, width,
+        ))
+    }
