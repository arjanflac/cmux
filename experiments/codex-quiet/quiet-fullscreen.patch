 impl HistoryCell for DynamicToolCallCell {
+    fn quiet_fullscreen_line(&self, width: u16) -> Option<HyperlinkLine> {
+        let data = self
+            .data
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if data.has_non_text_output {
+            return None;
+        }
+        let status = if data.interrupted {
+            "Interrupted"
+        } else {
+            match data.status {
+                DynamicToolCallStatus::InProgress => "Calling",
+                DynamicToolCallStatus::Completed => "Called",
+                DynamicToolCallStatus::Failed => "Failed",
+            }
+        };
+        Some(super::activity_preview::quiet_tool_line(
+            status, &data.name, width,
+        ))
+    }
