 impl HistoryCell for McpToolCallCell {
+    fn quiet_fullscreen_line(&self, width: u16) -> Option<HyperlinkLine> {
+        if let Some(Ok(result)) = &self.result
+            && result.content.iter().any(|block| !block.is_plain_text())
+        {
+            return None;
+        }
+        let status = match self.success() {
+            None => "Calling",
+            Some(true) => "Called",
+            Some(false) => "Failed",
+        };
+        Some(super::activity_preview::quiet_tool_line(
+            status,
+            &format!("{}.{}", self.invocation.server, self.invocation.tool),
+            width,
+        ))
+    }
+
     fn activity_ids(&self) -> Vec<String> {
         vec![format!("mcp:{}", self.call_id)]
     }
