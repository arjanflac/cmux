+    #[test]
+    fn cmux_resume_compat_rejects_unapproved_config_and_injection() {
+        for config in [
+            "check_for_update_on_startup=true", "check_for_update_on_startup=\"false\"",
+            "approval_policy=never", "sandbox_mode=danger-full-access", "approvals_reviewer=auto_review",
+            "features.daemon_auto_start=true", "model_provider=other", "model=gpt-6-luna",
+            "tui.title=anything", "model_reasoning_effort=unknown", "model_reasoning_effort=HIGH",
+            "model_reasoning_effort=", "model_reasoning_effort=\"high", "model_reasoning_effort=high\"",
+            "model_reasoning_effort=['high']", "model_reasoning_effort={value='high'}",
+            "model_reasoning_effort=high\napproval_policy='never'",
+            "model_reasoning_effort=\"high\"\napproval_policy='never'",
+            "model_reasoning_effort=high # comment", "model_reasoning_effort=high=never",
+            "model_reasoning_effort =high", "model_reasoning_effort= high", "other.key=false",
+        ] {
+            for flag in ["-c", "--config"] {
+                assert!(parse(&args(&[flag, config, "resume", SESSION])).is_err(), "{flag} {config:?}");
+                let joined = format!("{flag}={config}");
+                assert!(parse(&args(&["resume", SESSION, &joined])).is_err(), "{joined:?}");
+            }
+        }
+    }
