+/// Validate only the derived frontend launch lane, before any connection or input.
+pub fn parse(arguments: &[String]) -> anyhow::Result<crate::Cli> {
+    use clap::Parser;
+    use crate::Cli;
+
+    let mut rest = arguments;
+    let mut session = None;
+    let resume = rest.first().is_some_and(|a| a == "resume");
+    if resume {
+        rest = &rest[1..];
+        if rest.first().is_some_and(|a| !a.starts_with('-')) {
+            let value = &rest[0];
+            anyhow::ensure!(uuid::Uuid::parse_str(value).is_ok(), "only explicit resume UUIDs are supported");
+            session = Some(value.clone());
+            rest = &rest[1..];
+        }
+    }
+    let mut index = 0;
+    while index < rest.len() {
+        match rest[index].as_str() {
+            "-m" | "--model" | "-C" | "--cd" | "-s" | "--sandbox" | "-a" | "--ask-for-approval" => {
+                index += 1;
+                anyhow::ensure!(index < rest.len() && !rest[index].starts_with('-'), "missing option value");
+            }
+            "--dangerously-bypass-approvals-and-sandbox" => (),
+            _ => anyhow::bail!("unsupported invocation; use stock Codex"),
+        }
+        index += 1;
+    }
+    let mut cli = Cli::try_parse_from(std::iter::once("codex".to_string()).chain(rest.iter().cloned()))?;
+    cli.resume_picker = resume && session.is_none();
+    cli.resume_session_id = session;
+    Ok(cli)
+}
