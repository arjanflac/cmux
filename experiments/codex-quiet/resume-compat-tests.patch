+    #[test]
+    fn cmux_resume_compat_exact_native_restore() {
+        // Quotes here are TOML quotes retained in the argv, not shell syntax.
+        let cli = parse(&args(&[
+            "--yolo", "-c", "check_for_update_on_startup=false",
+            "-c", r#"model_reasoning_effort="high""#, "resume", SESSION,
+        ])).unwrap();
+        assert_eq!(cli.resume_session_id.as_deref(), Some(SESSION));
+        assert!(!cli.resume_picker);
+        assert!(cli.dangerously_bypass_approvals_and_sandbox);
+        assert!(cli.prompt.is_none());
+        assert!(!cli.no_alt_screen);
+        let overrides = cli.config_overrides.parse_overrides().unwrap();
+        assert_eq!(overrides[0].0, "check_for_update_on_startup");
+        assert_eq!(overrides[0].1.as_bool(), Some(false));
+        assert_eq!(overrides[1].0, "model_reasoning_effort");
+        assert_eq!(overrides[1].1.as_str(), Some("high"));
+    }
+
+    #[test]
