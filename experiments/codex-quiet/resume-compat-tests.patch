+            "--sandbox", "resume", "-a", "resume", "--model", "actual-model", "--cd", "/actual"]);
+        target.original = ["--yolo", "resume", "--model", "old-model"].into_iter().map(str::to_string).collect();
+        assert_eq!(capture_arguments(&target, &current), ["/stock/codex", "resume", "actual-session",
