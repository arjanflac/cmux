+        for values in [
+            vec!["resume", SESSION, "--yolo", "-c", "check_for_update_on_startup=false"],
+            vec!["--dangerously-bypass-approvals-and-sandbox", "resume", SESSION,
+                 "--config", "model_reasoning_effort=high"],
+            vec!["-C", "/tmp/project with spaces", "--config=check_for_update_on_startup=false",
+                 "resume", SESSION, "-m", "gpt-6-luna", "-c=model_reasoning_effort=high"],
+        ] {
+            let cli = parse(&args(&values)).unwrap();
+            assert_eq!(cli.resume_session_id.as_deref(), Some(SESSION));
+            assert!(cli.prompt.is_none());
+        }
+        let picker = parse(&args(&["-c", "check_for_update_on_startup=false", "resume"])).unwrap();
+        assert!(picker.resume_picker);
+        assert!(picker.resume_session_id.is_none());
+        let fresh = parse(&args(&["--yolo", "--config", "model_reasoning_effort=high"])).unwrap();
+        assert!(!fresh.resume_picker);
+        assert!(fresh.resume_session_id.is_none());
+    }
+
+    #[test]
+    fn cmux_resume_compat_known_efforts_and_exact_quote_forms() {
+        // Closed set of built-in wire values from the pinned ReasoningEffort.
+        for effort in ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra", "persistent"] {
+            for value in [effort.to_string(), format!("\"{effort}\""), format!("'{effort}'")] {
+                let config = format!("model_reasoning_effort={value}");
+                let cli = parse(&args(&["resume", SESSION, "-c", &config])).unwrap();
+                assert_eq!(cli.config_overrides.raw_overrides, vec![config]);
+                let parsed = cli.config_overrides.parse_overrides().unwrap();
+                assert_eq!(parsed[0].1.as_str(), Some(effort));
+            }
+        }
+    }
+
+    #[test]
+    fn cmux_resume_compat_config_values_and_precedence_are_preserved() {
+        let cli = parse(&args(&[
+            "--config", "model_reasoning_effort=low", "resume", SESSION,
+            "-c", r#"model_reasoning_effort="high""#,
+            "--config=check_for_update_on_startup=false",
+        ])).unwrap();
+        assert_eq!(cli.config_overrides.raw_overrides, vec![
+            "model_reasoning_effort=low", r#"model_reasoning_effort="high""#,
+            "check_for_update_on_startup=false",
+        ]);
+        assert!(cli.approval_policy.is_none());
+        assert!(cli.sandbox_mode.is_none());
+        assert!(!cli.dangerously_bypass_approvals_and_sandbox);
+    }
+
+    #[test]
+    fn cmux_resume_compat_permissions_match_upstream_without_added_bypass() {
+        for permission in [
+            vec![], vec!["--yolo"], vec!["--dangerously-bypass-approvals-and-sandbox"],
+            vec!["-a", "on-request", "--sandbox", "read-only"],
+            vec!["--ask-for-approval", "on-request", "-s", "workspace-write"],
+            vec!["--sandbox", "danger-full-access", "-a", "never"],
+        ] {
+            let stock = Cli::try_parse_from(std::iter::once("codex").chain(permission.iter().copied())).unwrap();
+            let mut restored = args(&permission);
+            restored.extend(args(&["-c", "check_for_update_on_startup=false", "resume", SESSION]));
+            let cli = parse(&restored).unwrap();
+            assert_eq!(cli.approval_policy.map(codex_protocol::protocol::AskForApproval::from), stock.approval_policy.map(codex_protocol::protocol::AskForApproval::from));
+            assert_eq!(cli.sandbox_mode.map(codex_protocol::config_types::SandboxMode::from), stock.sandbox_mode.map(codex_protocol::config_types::SandboxMode::from));
+            assert_eq!(cli.dangerously_bypass_approvals_and_sandbox, stock.dangerously_bypass_approvals_and_sandbox);
+            assert_eq!(cli.auto_review, stock.auto_review);
+            assert!(!cli.bypass_hook_trust);
+        }
+        for values in [
+            vec!["--yolo", "-a", "untrusted"],
+            vec!["--dangerously-bypass-approvals-and-sandbox", "--ask-for-approval", "on-request"],
+            vec!["--sandbox", "unknown"], vec!["-a", "unknown"],
+        ] {
+            assert!(parse(&args(&values)).is_err(), "{values:?}");
+        }
+    }
