+            vec!["resume", SESSION, "resume", SESSION], vec!["resume", "--last"],
+            vec!["resume", SESSION, "--", "hello"], vec!["exec"], vec!["fork", SESSION],
+            vec!["--remote", "unix:///tmp/other.sock"], vec!["--no-daemon"], vec!["--worktree"],
+            vec!["--dangerously-bypass-hook-trust"], vec!["--approve-for-me"], vec!["--search"],
+            vec!["--profile", "other"], vec!["--config"], vec!["-c"],
+            vec!["-c", "resume", SESSION], vec!["--config="], vec!["-cmodel_reasoning_effort=high"],
+            vec!["--model"], vec!["--model", "--yolo"], vec!["resume", SESSION, SESSION],
+        ] {
+            assert!(parse(&args(&values)).is_err(), "{values:?}");
+        }
+    }
+
+    #[test]
+    fn cmux_resume_compat_stock_cli_and_backend_feature_controls() {
+        // The normal TUI CLI is not extended by the derived eligibility helper.
+        let cli = Cli::try_parse_from(["codex", "--yolo"]).unwrap();
+        assert!(cli.dangerously_bypass_approvals_and_sandbox);
+        assert!(cli.config_overrides.raw_overrides.is_empty());
+        assert!(Cli::try_parse_from(["codex", "-c", "check_for_update_on_startup=false"]).is_err());
+        assert_eq!(require_embedded_allowed().is_err(), cfg!(feature = "cmux-quiet"));
+        assert_eq!(require_server_version(None).is_err(), cfg!(feature = "cmux-quiet"));
+    }
