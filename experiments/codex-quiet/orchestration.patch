+#[derive(Default)]
+struct State {
+    generation:u64, session:Option<String>, route:Option<Route>, tx:Option<AppEventSender>,
+    worker:Option<tokio::task::JoinHandle<()>>, calls:HashMap<codex_app_server_protocol::RequestId,tokio::task::JoinHandle<()>>, proof:Option<Proof>, seen:HashSet<String>,
+}
+static STATE:OnceLock<Mutex<State>>=OnceLock::new();
+static PROOF_CHANGES:OnceLock<tokio::sync::watch::Sender<u64>>=OnceLock::new();
+fn proof_changes()-> &'static tokio::sync::watch::Sender<u64> {
+    PROOF_CHANGES.get_or_init(||tokio::sync::watch::channel(0).0)
+}
+fn notify_proof_change() { proof_changes().send_modify(|value|*value=value.wrapping_add(1)); }
+fn runtime_state()-> &'static Mutex<State> { STATE.get_or_init(||Mutex::new(State::default())) }
+fn now()->f64 { SystemTime::now().duration_since(UNIX_EPOCH).map_or(0.0,|duration|duration.as_secs_f64()) }
+pub(crate) fn select(session:Option<String>,tx:AppEventSender) {
+    if !cfg!(feature="cmux-quiet") { return; }
+    let mut state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+    if session.is_some() && state.session==session { return; }
+    if let Some(worker)=state.worker.take() { worker.abort(); }
+    for (_,call) in state.calls.drain() { call.abort(); }
+    state.generation=state.generation.wrapping_add(1);
+    state.session=session; state.route=Route::environment(); state.tx=Some(tx);
+    state.proof=None; state.seen.clear();
+    notify_proof_change();
+}
+pub(crate) fn generation_for(session:&str)->Option<u64> {
+    let state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+    (state.session.as_deref()==Some(session)).then_some(state.generation)
+}
+pub(crate) fn is_selected(session:&str,generation:u64)->bool { generation_for(session)==Some(generation) }
+pub(crate) fn authorized(session:&str,generation:u64)->bool {
+    let proof={
+        let state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+        if state.session.as_deref()!=Some(session) || state.generation!=generation { return false; }
+        state.proof.clone()
+    };
+    proof.is_some_and(|proof|live_counts(&proof).is_some())
+}
+pub(crate) fn binding_verified(session:&str,generation:Option<u64>) {
+    if !cfg!(feature="cmux-quiet") { return; }
+    let mut state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+    if state.session.as_deref()!=Some(session) || generation!=Some(state.generation) || state.worker.is_some() { return; }
+    let (Some(route),Some(tx))=(state.route.clone(),state.tx.clone()) else { return; };
+    let session=session.to_string(); let generation=state.generation;
+    // Exactly one aggregate reader for this selection, never one per worker.
+    state.worker=Some(tokio::spawn(async move {
+        let Some(panel)=panel(&route,&session).await else { return; };
+        let proof=Proof { route,panel,session:session.clone(),generation };
+        let mut reader=SnapshotReader::default();
+        let mut previous=None;
+        loop {
+            let counts=reader.read(&proof,now());
+            {
+                let mut state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+                if state.session.as_deref()!=Some(session.as_str()) || state.generation!=generation { return; }
+                state.proof=counts.as_ref().map(|_|proof.clone());
+                notify_proof_change();
+                if counts.is_none() { for (_,call) in state.calls.drain() { call.abort(); } }
+            }
+            if counts!=previous || counts.is_none() {
+                // Proof loss is unknown, never evidence that prior workers completed.
+                let display=counts.clone().or_else(||previous.as_ref().filter(|last:&&Counts|last.line().is_some())
+                    .map(|_|Counts { unavailable:true,..Default::default() }));
+                tx.send(AppEvent::CmuxWorkers { session_id:session.clone(),generation,counts:display });
+            }
+            if counts.is_none() { return; } // Missing/expired proof stops, never re-enrolls automatically.
+            previous=counts;
+            tokio::time::sleep(Duration::from_secs(2)).await;
+        }
+    }));
+}
+fn accepts(params:&DynamicToolCallParams,session:&str)->bool {
+    cfg!(feature="cmux-quiet") && params.namespace.as_deref()==Some(NAMESPACE) && params.tool=="task"
+        && params.thread_id==session && !params.call_id.is_empty() && !params.turn_id.is_empty()
+        && params.call_id.len()<=512 && params.turn_id.len()<=512
+
+}
+pub(crate) fn claim(params:&DynamicToolCallParams)->Option<Proof> {
+    let mut state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+    let proof=state.proof.clone()?;
+    if !accepts(params,state.session.as_deref()?) || proof.generation!=state.generation
+        || live_counts(&proof).is_none() || state.seen.len()>=4096
+        || !state.seen.insert(json!([params.thread_id,params.turn_id,params.call_id]).to_string()) { return None; }
+    // Keep all call IDs for the selection, including uncertain calls. No local retries.
+    Some(proof)
+}
+/// A resolved native RPC can no longer dispatch a queued command. An already
+/// admitted mutation remains owned by the app ledger; abort never replays it.
+pub(crate) fn cancel_request(request_id:&codex_app_server_protocol::RequestId) {
+    if !cfg!(feature="cmux-quiet") { return; }
+    let mut state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+    if let Some(call)=state.calls.remove(request_id) { call.abort(); }
+}
+async fn wait_for_proof(session:&str,generation:u64,deadline:Duration)->Option<Proof> {
+    let mut changes=proof_changes().subscribe();
+    let wait=async {
+        loop {
+            let proof={
+                let state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+                if state.session.as_deref()!=Some(session) || state.generation!=generation { return None; }
+                state.proof.clone()
+            };
+            if let Some(proof)=proof.filter(|proof|live_counts(proof).is_some()) { return Some(proof); }
+            if changes.changed().await.is_err() { return None; }
+        }
+    };
+    tokio::time::timeout(deadline,wait).await.ok().flatten()
+}
+pub(crate) fn forward(params:&DynamicToolCallParams,request_id:codex_app_server_protocol::RequestId,tx:AppEventSender) {
+    if !cfg!(feature="cmux-quiet") { return; }
+    let mut state=runtime_state().lock().unwrap_or_else(|error|error.into_inner());
+    let Some(session)=state.session.as_deref() else { return; };
+    if state.route.is_none() || !accepts(params,session) { return; }
+    state.calls.retain(|_,call|!call.is_finished());
+    if state.calls.contains_key(&request_id) { return; }
+    if state.calls.len()>=32 || state.seen.len()>=4096 {
+        tx.send(AppEvent::CmuxWorkers { session_id:params.thread_id.clone(),generation:state.generation,
+            counts:Some(Counts { unavailable:true,..Default::default() }) });
+        return;
+    }
+    if !state.seen.insert(json!([params.thread_id,params.turn_id,params.call_id]).to_string()) { return; }
+    let generation=state.generation; let params=params.clone(); let key=request_id.clone();
+    let task=tokio::spawn(async move {
+        // Retain this exact provider request while asynchronous binding/enrollment
+        // finishes. Waiting is event-driven, bounded, and never a mutation retry.
+        let Some(proof)=wait_for_proof(&params.thread_id,generation,Duration::from_secs(30)).await else {
+            if is_selected(&params.thread_id,generation) {
+                tx.send(AppEvent::CmuxWorkers { session_id:params.thread_id,generation,
+                    counts:Some(Counts { unavailable:true,..Default::default() }) });
+            }
+            return;
+        };
+        let reply=bridge(&proof,&params).await;
+        // Only the app-selected responder may resolve this provider RPC. A lost
+        // designated frontend never transfers ownership or triggers a retry.
+        if reply.should_respond {
+            tx.send(AppEvent::CmuxToolCompleted { session_id:proof.session,generation:proof.generation,request_id,response:reply.response });
+        }
+    });
+    state.calls.insert(key,task);
+}
+#[derive(Clone,Deserialize)]
+struct Snapshot {
+    version:u32,session_id:String,frontend_pid:u32,invocation_id:String,updated_at:f64,expires_at:f64,
+    running:u64,needs_input:u64,unread:u64,disconnected:u64,
+}
+impl Snapshot {
+    fn counts(&self,proof:&Proof,now:f64)->Option<Counts> {
+        if self.version!=1 || self.session_id!=proof.session || self.frontend_pid!=proof.route.pid
+            || self.invocation_id!=proof.route.invocation || !self.updated_at.is_finite() || !self.expires_at.is_finite()
+            || self.updated_at<0.0 || self.updated_at>now+5.0 || self.expires_at<=now || self.expires_at<self.updated_at { return None; }
+        Some(Counts { running:self.running,needs_input:self.needs_input,unread:self.unread,disconnected:self.disconnected,unavailable:false })
+    }
+}
+#[cfg(unix)]
+fn private_file(path:&std::path::Path)->Option<std::fs::File> {
+    use std::os::unix::fs::{MetadataExt,OpenOptionsExt};
+    if !path.is_absolute() { return None; }
+    let before=std::fs::symlink_metadata(path).ok()?;
+    let valid=|metadata:&std::fs::Metadata|metadata.is_file() && metadata.uid()==unsafe { libc::geteuid() }
+        && metadata.mode()&0o7777==0o600 && metadata.len()<=16384;
+    if !valid(&before) { return None; }
+    let file=std::fs::OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW|libc::O_NONBLOCK|libc::O_CLOEXEC).open(path).ok()?;
+    let after=file.metadata().ok()?;
+    (valid(&after) && before.dev()==after.dev() && before.ino()==after.ino()).then_some(file)
+}
+#[cfg(not(unix))]
+fn private_file(_path:&std::path::Path)->Option<std::fs::File> { None }
+#[derive(Default)]
+struct SnapshotReader { stamp:Option<String>,snapshot:Option<Snapshot> }
+impl SnapshotReader {
+    fn read(&mut self,proof:&Proof,time:f64)->Option<Counts> {
+        if !cfg!(feature="cmux-quiet") { return None; }
+        // Verify scope metadata without ever reading its transport credential.
+        private_file(&proof.panel.scope_file)?;
+        let file=private_file(&proof.panel.snapshot_path)?;
+        let metadata=file.metadata().ok()?;
+        // Metadata includes inode/ctime on Unix, detecting atomic replacement and
+        // same-length rewrites. No subprocess and no content read when unchanged.
+        #[cfg(unix)]
+        let stamp={
+            use std::os::unix::fs::MetadataExt;
+            format!("{}:{}:{}:{}:{}:{}:{}",metadata.dev(),metadata.ino(),metadata.len(),metadata.mtime(),metadata.mtime_nsec(),metadata.ctime(),metadata.ctime_nsec())
+        };
+        #[cfg(not(unix))]
+        let stamp=format!("{metadata:?}");
+        if self.stamp.as_ref()!=Some(&stamp) {
+            let mut bytes=Vec::new(); file.take(16385).read_to_end(&mut bytes).ok()?;
+            if bytes.len()>16384 { return None; }
+            self.snapshot=serde_json::from_slice(&bytes).ok(); self.stamp=Some(stamp);
+        }
+        self.snapshot.as_ref()?.counts(proof,time)
+    }
+}
+fn live_counts(proof:&Proof)->Option<Counts> { SnapshotReader::default().read(proof,now()) }
+#[cfg(test)]
+fn counts_at(proof:&Proof,time:u64)->Option<Counts> { SnapshotReader::default().read(proof,time as f64) }
+fn command(route:&Route)->tokio::process::Command {
+    let mut command=tokio::process::Command::new(&route.cli);
+    command.args(["--socket",&route.socket,"task"])
+        .stderr(std::process::Stdio::null()).kill_on_drop(true);
+    command
+}
+/// Cap stdout while reading (not after wait_with_output has allocated it).
+async fn rpc(mut command:tokio::process::Command,input:Option<Vec<u8>>,limit:usize)->Option<Vec<u8>> {
+    command.stdin(if input.is_some() { std::process::Stdio::piped() } else { std::process::Stdio::null() })
+        .stdout(std::process::Stdio::piped());
+    let mut child=command.spawn().ok()?;
+    let mut stdout=child.stdout.take()?;
+    let mut stdin=child.stdin.take();
+    let operation=async {
+        let write=async {
+            if let (Some(bytes),Some(stream))=(input,stdin.as_mut()) { stream.write_all(&bytes).await.ok()?; stream.shutdown().await.ok()?; }
+            Some(())
+        };
+        let read=async {
+            let mut output=Vec::new(); (&mut stdout).take((limit+1) as u64).read_to_end(&mut output).await.ok()?;
+            (output.len()<=limit).then_some(output)
+        };
+        let (written,output)=tokio::join!(write,read);
+        written?; let output=output?;
+        if !child.wait().await.ok()?.success() { return None; }
+        Some(output)
+    };
+    // A timed out process is killed by drop. No fallback/retry after possible acceptance.
+    tokio::time::timeout(Duration::from_secs(30),operation).await.ok().flatten()
+}
+async fn panel(route:&Route,session:&str)->Option<Panel> {
+    if !cfg!(feature="cmux-quiet") { return None; }
+    // Session binding publication is asynchronous. Retry only this registration
+    // lookup; no bridge call or provider operation is retried here.
+    for delay in [0,300,1000] {
+        if delay>0 { tokio::time::sleep(Duration::from_millis(delay)).await; }
+        let mut command=command(route);
+        command.args(["panel","--workspace",&route.workspace,"--surface",&route.surface,"--session",session,
+            "--frontend-pid",&route.pid.to_string(),"--invocation",&route.invocation]);
+        if let Ok(Some(bytes))=tokio::time::timeout(Duration::from_secs(4),rpc(command,None,16384)).await {
+            if let Ok(panel)=serde_json::from_slice::<Panel>(&bytes) {
+                if panel.snapshot_path.is_absolute() && panel.scope_file.is_absolute() { return Some(panel); }
+            }
+        }
+    }
+    None
+}
+pub(crate) struct BridgeReply { response:DynamicToolCallResponse, should_respond:bool }
+impl BridgeReply {
