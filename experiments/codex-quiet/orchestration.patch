+pub(crate) async fn bridge(proof:&Proof,params:&DynamicToolCallParams)->BridgeReply {
+    if !authorized(&proof.session,proof.generation) {
+        return BridgeReply::withheld("cmux workers unavailable for this chat");
+    }
+    bridge_once(proof,params).await
+}
+async fn bridge_once(proof:&Proof,params:&DynamicToolCallParams)->BridgeReply {
+    let uncertain=||BridgeReply::withheld("cmux worker request outcome uncertain; inspect the cmux inbox before issuing a new request. No retry was attempted.");
+    if !accepts(params,&proof.session) { return BridgeReply::withheld("cmux workers unavailable for this chat"); }
+    // The body may carry a stable request UUID, but never overrides actual
+    // provider thread/turn/call metadata. Root normalizes and honors body IDs.
+    let mut command=command(&proof.route);
+    command.arg("bridge").arg("--scope-file").arg(&proof.panel.scope_file);
+    // Identity admits delivery; only the authoritative broker validates the
+    // action. Malformed argument shapes reach that broker as an empty object,
+    // producing an owned validation error without inventing a command.
+    let arguments=if params.arguments.is_object() { params.arguments.clone() } else { json!({}) };
+    let envelope=json!({"request_id":params.call_id,"caller_session_id":params.thread_id,"provider_turn_id":params.turn_id,"provider_call_id":params.call_id,"arguments":arguments});
+    let Ok(input)=serde_json::to_vec(&envelope) else { return uncertain(); };
+    if input.len()>262144 { return BridgeReply::withheld("cmux worker request is too large"); }
+    let Some(bytes)=rpc(command,Some(input),LIMIT).await else {
+        tracing::warn!("cmux worker request outcome uncertain; no response ownership or retry assumed");
+        return uncertain();
+    };
+    let Ok(mut value)=serde_json::from_slice::<serde_json::Value>(&bytes) else { return uncertain(); };
+    let Some(object)=value.as_object_mut() else { return uncertain(); };
+    // Reserved transport control never enters model content. Missing is accepted
+    // only in compatible unit fixtures; production requires an explicit true.
+    let should_respond=match object.remove("_cmux_should_respond") {
