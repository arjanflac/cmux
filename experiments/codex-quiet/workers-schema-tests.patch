@@ -420,3 +420,64 @@ fn fixture_ready(proof:Proof) {
 }
 #[cfg(test)]
 fn fixture_call_count()->usize { runtime_state().lock().unwrap().calls.len() }
+
+#[cfg(test)]
+mod workers_schema_tests {
+    use super::*;
+
+    fn route(enabled: bool) -> Route {
+        Route { cli: PathBuf::from("/fixture/cmux"), socket: "/fixture/socket".into(),
+            workspace: "00000000-0000-4000-8000-000000000001".into(),
+            surface: "00000000-0000-4000-8000-000000000002".into(),
+            invocation: "00000000-0000-4000-8000-000000000003".into(), pid: 123, enabled }
+    }
+
+    fn schema() -> Option<serde_json::Value> {
+        let mut request = ThreadStartParams::default();
+        augment(&mut request, Some(route(true)));
+        request.dynamic_tools.map(|tools| serde_json::to_value(tools).unwrap()[0]["tools"][0]["inputSchema"].clone())
+    }
+
+    #[test]
+    fn cmux_workers_schema_discovery_advertises_bounded_implicit_owner_parameters() {
+        let Some(schema) = schema() else { assert!(!cfg!(feature = "cmux-quiet")); return; };
+        assert!(schema["properties"]["action"]["enum"].as_array().unwrap().contains(&json!("workers")));
+        let body = &schema["properties"]["body"]["properties"];
+        assert_eq!(body["cursor"]["type"], "string");
+        assert_eq!(body["cursor"]["format"], "uuid");
+        assert_eq!(body["limit"], json!({"type":"integer","minimum":1,"maximum":50,"default":20}));
+        assert_eq!(body["include_retired"], json!({"type":"boolean","default":false}));
+        assert!(body.get("owner_task_id").is_none(), "Model discovery cannot select another owner");
+        assert_eq!(schema["required"], json!(["action"]), "Read-only discovery requires no mutation ID");
+    }
+
+    #[test]
+    fn cmux_workers_schema_lifetime_choices_are_discoverable_without_changing_permissions() {
+        let Some(schema) = schema() else { assert!(!cfg!(feature = "cmux-quiet")); return; };
+        let body = &schema["properties"]["body"]["properties"];
+        assert_eq!(body["lifecycle"]["type"], "string");
+        assert_eq!(body["lifecycle"]["enum"], json!(["persistent", "oneShot"]));
+        assert!(body["lifecycle"]["description"].as_str().unwrap().contains("schedule"));
+        assert!(body.get("permission_mode").is_none(), "Schema does not grant unrestricted worker permissions");
+        assert_eq!(body["provider"]["enum"],json!(["codex","claude","opencode"]));
+    }
+
+    #[test]
+    fn cmux_workers_schema_preserves_old_actions_and_feature_scoping() {
+        for selected in [None, Some(route(false))] {
+            let mut request = ThreadStartParams::default(); augment(&mut request,selected);
+            assert!(request.dynamic_tools.is_none());
+        }
+        let mut request = ThreadStartParams::default();
+        augment(&mut request,Some(route(true))); augment(&mut request,Some(route(true)));
+        if !cfg!(feature = "cmux-quiet") { assert!(request.dynamic_tools.is_none()); return; }
+        let tools = serde_json::to_value(request.dynamic_tools.unwrap()).unwrap();
+        assert_eq!(tools.as_array().unwrap().len(),1);
+        assert_eq!(tools[0]["name"], "cmux_tasks");
+        assert_eq!(tools[0]["tools"][0]["name"], "task");
+        let actions = tools[0]["tools"][0]["inputSchema"]["properties"]["action"]["enum"].as_array().unwrap();
+        for action in ["start","send","read","turns","result","wait","cancel","interactions","respond","inbox","ack","schedule.create","schedule.list","schedule.read","schedule.pause","schedule.resume","schedule.cancel","schedule"] {
+            assert!(actions.contains(&json!(action)),"Existing action disappeared: {action}");
+        }
+    }
+}
