+//! Behavioral coverage for known routine cells in the owned quiet viewport.
+//! The same fixtures run with the feature disabled; no provider or socket work.
+//! Image preservation uses only a tiny disposable PNG fixture.
+
+use super::*;
+use crate::diff_model::FileChange;
+use crate::exec_cell::{CommandOutput, ExecCall, ExecCell};
+use crate::history_cell::*;
+use crate::test_support::{PathBufExt, test_path_buf};
+use codex_app_server_protocol::CommandExecutionSource as ExecCommandSource;
+use codex_app_server_protocol::{DynamicToolCallStatus, ThreadItem, WebSearchAction};
+use codex_protocol::mcp::CallToolResult;
+use codex_protocol::parse_command::ParsedCommand;
+use codex_utils_path_uri::LegacyAppPathString;
+use serde_json::json;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+pub(crate) const TOKEN: &str = "COVERAGE_NEEDLE";
+const PNG: &str = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==";
+
+pub(crate) fn patch() -> Box<dyn HistoryCell> {
+    Box::new(new_patch_event(
+        HashMap::from([
+            (
+                PathBuf::from("one.txt"),
+                FileChange::Add {
+                    content: format!("{TOKEN}\n"),
+                },
+            ),
+            (
+                PathBuf::from("two.txt"),
+                FileChange::Update {
+                    unified_diff: format!("@@ -1 +1 @@\n-before\n+{TOKEN}\n"),
+                    move_path: None,
+                },
+            ),
+        ]),
+        Path::new("/workspace"),
+    ))
+}
+
+pub(crate) fn mcp(server: &str, outcome: &str) -> McpToolCallCell {
+    let mut call = McpToolCallCell::new(
+        format!("{server}-{outcome}"),
+        McpInvocation {
+            server: server.into(),
+            tool: "js".into(),
+            arguments: Some(json!({"title": TOKEN, "code": TOKEN})),
+        },
+        false,
+    );
+    if outcome == "interrupted" {
+        call.mark_failed();
+    } else if outcome != "active" {
+        let result = if outcome == "transport" {
+            Err(format!("{TOKEN} transport error"))
+        } else {
+            let block = match outcome {
+                "image" | "failed-image" => {
+                    json!({"type": "image", "mimeType": "image/png", "data": PNG})
+                }
+                "audio" => json!({"type": "audio", "mimeType": "audio/wav", "data": ""}),
+                "resource" => {
+                    json!({"type": "resource_link", "uri": "file:///workspace/artifact.pdf", "name": TOKEN})
+                }
+                "unknown" => json!({"type": "future", "value": TOKEN}),
+                _ => json!({"type": "text", "text": TOKEN}),
+            };
+            Ok(CallToolResult {
+                content: vec![block],
+                structured_content: None,
+                is_error: Some(outcome.starts_with("failed")),
+                meta: None,
+            })
+        };
+        call.complete(Duration::ZERO, result);
+    }
+    call
+}
+
+pub(crate) fn computer(outcome: &str) -> ComputerActivityCell {
+    let mut cell = ComputerActivityCell::default();
+    for index in 0..5 {
+        // Distinct invocation IDs exercise the real five-action grouping rather than deduplication.
+        let call = if index == 4 {
+            mcp("cua_repl", outcome)
+        } else {
+            let mut call = McpToolCallCell::new(
+                format!("computer-{index}"),
+                McpInvocation {
+                    server: "cua_repl".into(),
+                    tool: "js".into(),
+                    arguments: Some(json!({"title": TOKEN, "code": TOKEN})),
+                },
+                false,
+            );
+            call.complete(
+                Duration::ZERO,
+                Ok(CallToolResult {
+                    content: vec![json!({"type": "text", "text": TOKEN})],
+                    structured_content: None,
+                    is_error: Some(false),
+                    meta: None,
+                }),
+            );
+            call
+        };
+        cell.start(call);
+    }
+    cell
+}
+
+pub(crate) fn dynamic(
+    status: DynamicToolCallStatus,
+    success: Option<bool>,
+    media: bool,
+) -> DynamicToolCallCell {
+    let item: ThreadItem = serde_json::from_value(json!({
+        "type": "dynamicToolCall", "id": "dynamic-coverage", "namespace": "browser", "tool": "open",
+        "arguments": {"url": TOKEN}, "status": status, "success": success,
+        "contentItems": if media { json!([{"type": "inputImage", "imageUrl": "data:image/png;base64,AA=="}]) }
+                        else { json!([{"type": "inputText", "text": TOKEN}]) },
+        "durationMs": null
+    })).expect("pinned dynamic tool shape");
+    DynamicToolCallCell::from_item(item).unwrap()
+}
+
+pub(crate) fn exec(code: Option<i32>, source: ExecCommandSource) -> ExecCell {
+    let mut cell = ExecCell::new(
+        ExecCall {
+            call_id: "exec-coverage".into(),
+            command: vec!["echo".into(), TOKEN.into()],
+            parsed: if matches!(source, ExecCommandSource::Agent) {
+                vec![ParsedCommand::Search {
+                    cmd: format!("rg {TOKEN}"),
+                    query: Some(TOKEN.into()),
+                    path: None,
+                }]
+            } else {
+                Vec::new()
+            },
+            output: None,
+            source,
+            start_time: Some(Instant::now()),
+            duration: None,
+            interaction_input: None,
+        },
+        false,
+    );
+    if let Some(code) = code {
+        assert!(cell.complete_call(
+            "exec-coverage",
+            CommandOutput::new(code, TOKEN.into()),
+            Duration::ZERO
+        ));
+    }
+    cell
+}
+
+pub(crate) fn routine_cells() -> Vec<Box<dyn HistoryCell>> {
+    let mut cells: Vec<Box<dyn HistoryCell>> = vec![
+        patch(),
+        Box::new(computer("active")),
+        Box::new(computer("completed")),
+        Box::new(computer("image")),
+        Box::new(mcp("cua_repl", "image")),
+        Box::new(mcp("browser", "completed")),
+        Box::new(dynamic(DynamicToolCallStatus::InProgress, None, false)),
+        Box::new(dynamic(DynamicToolCallStatus::Completed, Some(true), false)),
+        Box::new(exec(None, ExecCommandSource::Agent)),
+        Box::new(exec(Some(0), ExecCommandSource::UnifiedExecStartup)),
+        Box::new(exec(Some(0), ExecCommandSource::UnifiedExecInteraction)),
+        Box::new(new_view_image_tool_call(
+            "view".into(),
+            LegacyAppPathString::from_string(format!("/workspace/{TOKEN}.png")),
+        )),
+    ];
+    for action in [
+        None,
+        Some(WebSearchAction::Search {
+            query: Some(TOKEN.into()),
+            queries: None,
+        }),
+        Some(WebSearchAction::OpenPage {
+            url: Some(format!("https://example.test/{TOKEN}")),
+        }),
+        Some(WebSearchAction::FindInPage {
+            url: None,
+            pattern: Some(TOKEN.into()),
+        }),
+    ] {
+        let mut active = WebSearchCell::new("web".into(), TOKEN.into(), action.clone(), false);
+        cells.push(Box::new(WebSearchCell::new(
+            "web-active".into(),
+            TOKEN.into(),
+            action,
+            false,
+        )));
+        active.complete();
+        cells.push(Box::new(active));
+    }
+    for status in ["pending", "in_progress", "completed"] {
+        cells.push(Box::new(new_plan_update(serde_json::from_value(json!({
+            "explanation": TOKEN,
+            "plan": [{"step": TOKEN, "status": status}]
+        })).unwrap())));
+    }
+    cells
+}
+
+fn draw(view: &mut TranscriptView, cells: &[Arc<dyn HistoryCell>], width: u16) -> Buffer {
+    let area = Rect::new(0, 0, width, 36);
+    let mut buffer = Buffer::empty(area);
+    view.render(area, &mut buffer, cells);
+    buffer
+}
+
+pub(crate) fn assert_routine(cell: Box<dyn HistoryCell>) {
+    let cell: Arc<dyn HistoryCell> = Arc::from(cell);
+    let raw = cell.raw_lines();
+    let full = cell.transcript_hyperlink_lines(100);
+    let cells = [cell.clone()];
+    let mut view = TranscriptView::default();
+    for width in [100, 1, 8, 24, 100] {
+        draw(&mut view, &cells, width);
+        let quiet = view.entry_layout(&cells, 0, false).unwrap();
+        if cfg!(feature = "cmux-quiet") {
+            assert_eq!(quiet.row_count(), 0, "{cell:?}: {}", quiet.text());
+            assert!(quiet.image.is_none());
+        }
+        // Search uses this full-content layout, independently of presentation.
+        assert!(
+            !view
+                .entry_layout(&cells, 0, true)
+                .unwrap()
+                .text()
+                .is_empty()
+        );
+    }
+    for _ in 0..3 {
+        view.toggle_cmux_quiet();
+        draw(&mut view, &cells, 100);
+        assert!(
+            !view
+                .entry_layout(&cells, 0, false)
+                .unwrap()
+                .text()
+                .is_empty()
+        );
+        view.toggle_cmux_quiet();
+        draw(&mut view, &cells, 100);
+        assert_eq!(
+            view.entry_layout(&cells, 0, false).unwrap().row_count() == 0,
+            cfg!(feature = "cmux-quiet")
+        );
+    }
+    view.set_presentation(true, HistoryRenderMode::Rich);
+    draw(&mut view, &cells, 100);
+    assert!(view.layout(&cells, 0).unwrap().text().contains(TOKEN));
+    view.set_presentation(true, HistoryRenderMode::Raw);
+    draw(&mut view, &cells, 100);
+    assert!(!view.layout(&cells, 0).unwrap().text().is_empty());
+    assert_eq!(cell.raw_lines(), raw);
+    assert!(crate::terminal_hyperlinks::lines_with_sources_eq(
+        &cell.transcript_hyperlink_lines(100),
+        &full
+    ));
+}
