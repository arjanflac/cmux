+pub(crate) fn expanded_view_for_activity(ids: Vec<String>) -> TranscriptView {
+    let mut view = TranscriptView::default();
+    if view.is_cmux_quiet() { view.toggle_cmux_quiet(); }
+    view.disclosure.expanded.extend(ids.iter().cloned());
+    view.disclosure.focused = Some(ids);
+    view
+}
