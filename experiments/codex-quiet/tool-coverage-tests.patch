+pub(crate) fn protected_cells() -> Vec<Box<dyn HistoryCell>> {
+    let mut interrupted_exec = exec(None, ExecCommandSource::Agent);
+    interrupted_exec.mark_failed();
+    let interrupted = dynamic(DynamicToolCallStatus::InProgress, None, false);
+    interrupted.mark_interrupted();
+    let mut cells: Vec<Box<dyn HistoryCell>> = vec![
+        Box::new(new_patch_apply_failure(TOKEN.into())),
+        Box::new(new_patch_apply_failure(String::new())),
+        Box::new(computer("failed")),
+        Box::new(computer("failed-image")),
+        Box::new(interrupted_exec),
+        Box::new(computer("transport")),
+        Box::new(computer("interrupted")),
+        Box::new(mcp("browser", "failed")),
+        Box::new(mcp("browser", "transport")),
+        Box::new(mcp("browser", "interrupted")),
+        Box::new(dynamic(DynamicToolCallStatus::Failed, None, false)),
+        Box::new(dynamic(
+            DynamicToolCallStatus::Completed,
+            Some(false),
+            false,
+        )),
+        Box::new(interrupted),
+        Box::new(exec(Some(1), ExecCommandSource::Agent)),
+        Box::new(exec(Some(130), ExecCommandSource::UnifiedExecStartup)),
+        Box::new(exec(Some(0), ExecCommandSource::UserShell)),
+        Box::new(mcp("browser", "image")),
+        Box::new(mcp("node_repl", "image")),
+        Box::new(mcp("cua_repl", "audio")),
+        Box::new(mcp("cua_repl", "resource")),
+        Box::new(mcp("cua_repl", "unknown")),
+        Box::new(dynamic(DynamicToolCallStatus::Completed, Some(true), true)),
+        Box::new(PlainHistoryCell::new(vec![TOKEN.into()])),
+        Box::new(AgentMessageCell::new(
+            vec![format!("Assistant final {TOKEN}").into()],
+            true,
+        )),
+        Box::new(new_user_prompt(TOKEN.into(), vec![], vec![], vec![])),
+        Box::new(new_user_prompt(
+            String::new(),
+            vec![],
+            vec![PathBuf::from("user-image.png")],
+            vec![],
+        )),
+        Box::new(new_image_generation_call(
+            "image".into(),
+            "completed",
+            Some(TOKEN.into()),
+            Some(test_path_buf("/workspace/assistant-image.png").abs()),
+        )),
+        Box::new(new_image_generation_call(
+            "image".into(),
+            "failed",
+            Some(TOKEN.into()),
+            None,
+        )),
+        new_approval_decision_cell(
+            ApprovalDecisionSubject::Command(vec![TOKEN.into()]),
+            ReviewDecision::Approved,
+            ApprovalDecisionActor::User,
+        ),
+        new_guardian_denied_action_request(TOKEN.into()),
+        Box::new(RequestUserInputResultCell {
+            questions: vec![],
+            answers: HashMap::new(),
+            interrupted: true,
+        }),
+    ];
+    for status in [codex_app_server_protocol::HookRunStatus::Completed,
+                   codex_app_server_protocol::HookRunStatus::Failed,
+                   codex_app_server_protocol::HookRunStatus::Blocked,
+                   codex_app_server_protocol::HookRunStatus::Stopped] {
+        for kind in [codex_app_server_protocol::HookOutputEntryKind::Warning,
+                     codex_app_server_protocol::HookOutputEntryKind::Error,
+                     codex_app_server_protocol::HookOutputEntryKind::Stop,
+                     codex_app_server_protocol::HookOutputEntryKind::Feedback] {
+            cells.push(Box::new(new_completed_hook_cell(codex_app_server_protocol::HookRunSummary {
+                id: "hook-coverage".into(),
+                event_name: codex_app_server_protocol::HookEventName::PostToolUse,
+                handler_type: codex_app_server_protocol::HookHandlerType::Command,
+                execution_mode: codex_app_server_protocol::HookExecutionMode::Sync,
+                scope: codex_app_server_protocol::HookScope::Turn,
+                source_path: test_path_buf("/tmp/hooks.json").abs(),
+                source: codex_app_server_protocol::HookSource::User,
+                display_order: 0, status: status.clone(), status_message: None,
+                started_at: 1, completed_at: Some(2), duration_ms: Some(1),
+                entries: vec![codex_app_server_protocol::HookOutputEntry { kind, text: TOKEN.into() }],
+            })));
+        }
+    }
+    cells
+}
