+async fn cmux_tool_coverage_live_and_replayed_native_computer_screenshot() {
+    for replay in [false, true] {
+        let (mut chat, mut events, _ops) = make_chatwidget_manual(None).await;
+        let item: AppServerThreadItem = serde_json::from_value(json!({
+            "type": "mcpToolCall", "id": "computer-image", "server": "cua_repl", "tool": "js",
+            "status": "completed", "arguments": {"title": TOKEN, "code": "await cua.getState()"},
+            "result": {"content": [{"type": "image", "mimeType": "image/png",
+                "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg=="}]},
+            "durationMs": 1
+        })).unwrap();
+        if replay {
+            chat.replay_thread_item(item, "turn".into(), ReplayKind::ThreadSnapshot);
+        } else {
+            let mut started = item.clone();
+            if let AppServerThreadItem::McpToolCall { status, result, .. } = &mut started {
+                *status = codex_app_server_protocol::McpToolCallStatus::InProgress;
+                *result = None;
+            }
+            chat.on_mcp_tool_call_started(started);
+            assert_eq!(
+                chat.active_cell_owned_transcript_lines_with_focus(100, false, true)
+                    .is_none(),
+                cfg!(feature = "cmux-quiet")
+            );
+            chat.on_mcp_tool_call_completed(item);
+        }
+        // Group may remain active until its boundary or be committed during replay.
+        if let Some(cell) = chat.transcript.active_cell.as_deref() {
+            assert!(cell.as_any().is::<history_cell::ComputerActivityCell>());
+            assert!(
+                cell.transcript_lines(100)
+                    .iter()
+                    .any(|line| line.to_string().contains(TOKEN))
+            );
+            assert_eq!(
+                chat.active_cell_owned_transcript_lines_with_focus(100, false, true)
+                    .is_none(),
+                cfg!(feature = "cmux-quiet")
+            );
+        } else {
+            let mut cells = Vec::new();
+            while let Ok(event) = events.try_recv() {
+                if let AppEvent::InsertHistoryCell(cell) = event {
+                    cells.push(cell);
+                }
+            }
+            assert_eq!(cells.len(), 1);
+            assert!(cells[0].as_any().is::<history_cell::ComputerActivityCell>());
+            crate::transcript_view::cmux_tool_coverage_tests::assert_routine(cells.remove(0));
+        }
+    }
