+
+#[cfg(feature = "cmux-quiet")]
+#[tokio::test]
+async fn cmux_focus_live_activity_preserves_assistant_text_and_full_transcript() {
+    use crate::exec_cell::ExecCall;
+    use crate::exec_cell::ExecCell;
+    use crate::history_cell::PlainHistoryCell;
+    use std::time::Instant;
+
+    let (mut chat, _events, _ops) = make_chatwidget_manual(None).await;
+    let mut active = ExecCell::new(
+        ExecCall {
+            call_id: "quiet-live".into(),
+            command: vec!["bash".into(), "-lc".into(), "LIVE_ARGS ".repeat(1024)],
+            parsed: Vec::new(),
+            output: None,
+            source: ExecCommandSource::Agent,
+            start_time: Some(Instant::now()),
+            duration: None,
+            interaction_input: None,
+        },
+        false,
+    );
+    assert!(active.append_output("quiet-live", &"LIVE_OUTPUT\n".repeat(512)));
+    chat.transcript.active_cell = Some(Box::new(active));
+    chat.realtime_conversation
+        .pending_history_cells
+        .push_back(Box::new(PlainHistoryCell::new(vec![
+            "AUXILIARY_TEXT must remain visible.".into(),
+        ])));
+
+    let full_before = chat.active_cell_transcript_hyperlink_lines(100).unwrap();
+    let focus = chat.active_cell_owned_transcript_lines_with_focus(100, false, true).unwrap();
+    assert!(focus.activity.is_empty());
+    assert!(focus.disclosure.is_none());
+    assert!(focus.auxiliary.iter().any(|line| line.line.to_string().contains("AUXILIARY_TEXT")));
+    let details = chat.active_cell_owned_transcript_lines_with_focus(100, false, false).unwrap();
+    assert!(details.activity.iter().any(|line| line.line.to_string().contains("LIVE_ARGS")));
+    let expanded = chat.active_cell_owned_transcript_lines(100, true).unwrap();
+    let text = expanded
+        .activity
+        .iter()
+        .map(|line| line.line.to_string())
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(text.contains("LIVE_ARGS"));
+    assert!(text.contains("LIVE_OUTPUT"));
+    assert!(crate::terminal_hyperlinks::lines_with_sources_eq(
+        &chat.active_cell_transcript_hyperlink_lines(100).unwrap(),
+        &full_before,
+    ));
+}
