+use super::*;
+use serde_json::json;
+use std::time::Duration;
+#[cfg(unix)]
+use std::os::unix::fs::PermissionsExt;
+
+fn route() -> Route { Route { cli: "/usr/bin/true".into(), socket: "/fixture.sock".into(), workspace: uuid::Uuid::new_v4().to_string(), surface: uuid::Uuid::new_v4().to_string(), invocation: "fresh-invocation".into(), pid: std::process::id(), enabled:true } }
+fn params() -> DynamicToolCallParams { DynamicToolCallParams { thread_id: uuid::Uuid::new_v4().to_string(), turn_id: "turn-real".into(), call_id: "call-real".into(), namespace: Some(NAMESPACE.into()), tool: "task".into(), arguments: json!({"action":"inbox"}) } }
+#[cfg(unix)]
+fn fixture() -> (tempfile::TempDir, Proof) {
+    let dir = tempfile::tempdir().unwrap();
+    let proof = Proof { route: route(), panel: Panel { snapshot_path: dir.path().join("snapshot.json"), scope_file: dir.path().join("scope.json") }, session: params().thread_id, generation: 42 };
+    std::fs::write(&proof.panel.scope_file, "private-credential-never-context").unwrap();
+    std::fs::set_permissions(&proof.panel.scope_file, std::fs::Permissions::from_mode(0o600)).unwrap();
+    write_snapshot(&proof, 100, 200);
+    (dir, proof)
+}
+#[cfg(unix)]
+fn write_snapshot(proof: &Proof, updated: u64, expires: u64) {
+    let value = json!({"version":1,"session_id":proof.session,"frontend_pid":proof.route.pid,"invocation_id":proof.route.invocation,"updated_at":updated,"expires_at":expires,"running":2,"needs_input":1,"unread":1,"disconnected":0});
+    std::fs::write(&proof.panel.snapshot_path, value.to_string()).unwrap();
+    std::fs::set_permissions(&proof.panel.snapshot_path, std::fs::Permissions::from_mode(0o600)).unwrap();
+}
+#[test]
+fn cmux_orchestration_row_counts_update_and_clear() {
+    let mut counts = Counts { running:2, unread:1, needs_input:1, disconnected:0,..Default::default() };
+    assert_eq!(counts.line(), cfg!(feature="cmux-quiet").then(|| "cmux workers · 2 running · 1 result · 1 needs input".into()));
+    counts.running = 0; counts.unread=0; counts.needs_input=0; counts.disconnected=1;
+    assert_eq!(counts.line(), cfg!(feature="cmux-quiet").then(|| "cmux workers · 1 disconnected".into()));
+    assert!(Counts::default().line().is_none());
+}
+#[test]
+fn cmux_orchestration_namespace_and_actual_ids_only() {
+    let mut call=params();
+    assert_eq!(accepts(&call,&call.thread_id), cfg!(feature="cmux-quiet"));
+    assert!(!accepts(&call,"other-thread"));
+    for arguments in [json!({"action":"unsupported"}),json!({}),json!(null),json!([])] {
+        call.arguments=arguments;assert_eq!(accepts(&call,&call.thread_id),cfg!(feature="cmux-quiet"),"validation belongs to the owned broker");
+    }
+    call.namespace=Some("codex_tui".into()); assert!(!accepts(&call,&call.thread_id));
+    call.namespace=None; assert!(!accepts(&call,&call.thread_id));
+    call.namespace=Some(NAMESPACE.into()); call.call_id.clear(); assert!(!accepts(&call,&call.thread_id));
+}
+#[test]
+fn cmux_orchestration_augments_without_overwriting_stock_tools_or_instructions() {
+    let mut request=ThreadStartParams::default();
+    request.dynamic_tools=Some(crate::dynamic_tools::tool_specs());
+    request.developer_instructions=Some("keep original".into());
+    let stock=request.clone();
+    augment(&mut request,None); assert_eq!(request,stock);
+    augment(&mut request,Some(route()));
+    assert_eq!(request.developer_instructions,stock.developer_instructions);
+    let tools=request.dynamic_tools.as_ref().unwrap();
+    assert_eq!(&tools[..stock.dynamic_tools.as_ref().unwrap().len()],stock.dynamic_tools.as_ref().unwrap());
+    assert_eq!(tools.len(),stock.dynamic_tools.as_ref().unwrap().len()+usize::from(cfg!(feature="cmux-quiet")));
+    let once=request.clone(); augment(&mut request,Some(route())); assert_eq!(request,once);
+}
+#[test]
+fn cmux_orchestration_route_requires_explicit_fresh_frontend_hints() {
+    let target=route();
+    let mut values=std::collections::HashMap::from([
+        ("CMUX_ORCHESTRATOR_ENABLED","1".to_string()),("CMUX_CODEX_PID",target.pid.to_string()),
+        ("CMUX_CODEX_INVOCATION_ID",target.invocation.clone()),("CMUX_BUNDLED_CLI_PATH",target.cli.to_string_lossy().into_owned()),
+        ("CMUX_SOCKET_PATH",target.socket.clone()),("CMUX_WORKSPACE_ID",target.workspace.clone()),("CMUX_SURFACE_ID",target.surface.clone())]);
+    assert_eq!(Route::from_values(|key|values.get(key).cloned(),target.pid).is_some(),cfg!(feature="cmux-quiet"));
+    for key in ["CMUX_ORCHESTRATOR_ENABLED","CMUX_CODEX_PID","CMUX_CODEX_INVOCATION_ID","CMUX_WORKSPACE_ID","CMUX_SURFACE_ID"] {
+        let old=values.insert(key,String::new());
+        assert!(Route::from_values(|key|values.get(key).cloned(),target.pid).is_none());
+        values.insert(key,old.unwrap());
+    }
+    assert!(Route::from_values(|key|values.get(key).cloned(),target.pid+1).is_none());
+    values.insert("CMUX_ORCHESTRATOR_ENABLED","0".into());
+    let disabled=Route::from_values(|key|values.get(key).cloned(),target.pid);
+    assert_eq!(disabled.is_some(),cfg!(feature="cmux-quiet"));
+    if let Some(disabled)=disabled {
+        assert!(!disabled.enabled);
+        let mut request=ThreadStartParams::default(); let before=request.clone();
+        augment(&mut request,Some(disabled)); assert_eq!(request,before);
+    }
+}
