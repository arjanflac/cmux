+// Owned broker mock: dedupe side effects by actual provider identity and choose
+// one registration to answer. All forwarders receive the same completion body.
+#[cfg(unix)]
+const OWNED_BROKER_FIXTURE:&str=r#"#!/usr/bin/env python3
+import json,pathlib,sys
+assert sys.argv[1:5]==['--socket','/fixture.sock','task','bridge']
+assert sys.argv[5]=='--scope-file' and len(sys.argv)==7
+x=json.load(sys.stdin)
+assert x['caller_session_id']==SESSION
+assert x['provider_turn_id']=='turn-real' and x['provider_call_id']=='call-real'
+assert x['request_id']=='call-real'
+assert x['arguments']['body']['request_id']==STABLE_ID
+# Root owns normalization; body identity claims cannot replace transport IDs.
+assert x['arguments']['body']['caller_session_id']=='forged-thread'
+p=pathlib.Path(BROKER)
+state=json.loads(p.read_text()) if p.exists() else {'effects':0,'forwards':0}
+key=[x['caller_session_id'],x['provider_turn_id'],x['provider_call_id']]
+if 'key' not in state:
+    state.update(key=key,responder=sys.argv[6],effects=state['effects']+1,
+                 result={'operation_id':STABLE_ID,'phase':'completed','result':'same-completion'})
+assert state['key']==key
+state['forwards']+=1
+p.write_text(json.dumps(state))
+if DROP_DESIGNATED and state['responder']==sys.argv[6]:
+    sys.exit(1)
+print(json.dumps(dict(state['result'],_cmux_should_respond=state['responder']==sys.argv[6])))
+"#;
