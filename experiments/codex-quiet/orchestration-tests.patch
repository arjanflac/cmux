+#[cfg(unix)]
+async fn two_forwarders(drop_designated:bool) {
+    if !cfg!(feature="cmux-quiet") { return; }
+    let (dir,mut proof)=fixture();
+    let time=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs(); write_snapshot(&proof,time,time+60);
+    let stable=uuid::Uuid::new_v4().to_string(); let broker=dir.path().join("broker.json");
+    proof.route.cli=dir.path().join("cmux");
+    let script=OWNED_BROKER_FIXTURE.replace("SESSION",&serde_json::to_string(&proof.session).unwrap())
+        .replace("STABLE_ID",&serde_json::to_string(&stable).unwrap())
+        .replace("BROKER",&serde_json::to_string(&broker.to_string_lossy()).unwrap())
+        .replace("DROP_DESIGNATED",if drop_designated { "True" } else { "False" });
+    std::fs::write(&proof.route.cli,script).unwrap();
+    std::fs::set_permissions(&proof.route.cli,std::fs::Permissions::from_mode(0o700)).unwrap();
+    let mut call=params(); call.thread_id=proof.session.clone();
+    call.arguments=json!({"action":"start","body":{"request_id":stable,"caller_session_id":"forged-thread","provider_turn_id":"forged-turn","provider_call_id":"forged-call"}});
+    let (tx,mut rx)=tokio::sync::mpsc::unbounded_channel(); let tx=AppEventSender::new(tx);
+    // Simulate independent attached processes, each with its own local seen set.
+    for frontend in 0..2 {
+        if frontend==1 {
+            proof.panel.scope_file=dir.path().join("scope-second.json");
+            std::fs::write(&proof.panel.scope_file,"second-private-registration").unwrap();
+            std::fs::set_permissions(&proof.panel.scope_file,std::fs::Permissions::from_mode(0o600)).unwrap();
+        }
+        fixture_enroll(proof.clone(),tx.clone());
+        forward(&call,codex_app_server_protocol::RequestId::String(format!("rpc-{frontend}")),tx.clone());
+        fixture_finish_calls().await;
+    }
+    // Mock the owned provider RPC response sink at the real AppEvent boundary.
+    #[derive(Default)]
+    struct OwnedResponseBroker { responses:Vec<(codex_app_server_protocol::RequestId,serde_json::Value)> }
+    impl OwnedResponseBroker {
+        async fn resolve_server_request(&mut self,id:codex_app_server_protocol::RequestId,result:serde_json::Value) {
+            self.responses.push((id,result));
+        }
+    }
+    let mut owned=OwnedResponseBroker::default();
+    while let Ok(event)=rx.try_recv() {
+        if let AppEvent::CmuxToolCompleted { request_id,response,.. }=event {
+            owned.resolve_server_request(request_id,serde_json::to_value(response).unwrap()).await;
+        } else { panic!("bridge emitted unrelated event"); }
+    }
+    let responses=owned.responses;
+    assert_eq!(responses.len(),usize::from(!drop_designated));
+    if !drop_designated {
+        assert_eq!(responses[0].0,codex_app_server_protocol::RequestId::String("rpc-0".into()));
+        let model=responses[0].1.to_string();
+        assert!(model.contains("same-completion")); assert!(!model.contains("_cmux_should_respond"));
+    }
+    let state:serde_json::Value=serde_json::from_slice(&std::fs::read(broker).unwrap()).unwrap();
+    assert_eq!(state["effects"],1); assert_eq!(state["forwards"],2,"no bridge retry or responder takeover");
+    select(None,tx);
+}
