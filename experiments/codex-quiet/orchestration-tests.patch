+use super::*;
+use crate::app::owned_transcript::tests::{attach_thread, buffer_text};
+#[tokio::test]
+async fn cmux_orchestration_owned_screen_is_passive_and_preserves_history() -> Result<()> {
+    let (mut app,mut events,_ops)=crate::app::tests::make_test_app_with_channels().await;
+    attach_thread(&mut app,ThreadId::new());
+    app.local_settings.tui.animations=false;
+    app.transcript_cells=vec![
+        Arc::new(history_cell::PlainHistoryCell::new(vec!["Assistant prose stays.".into()])),
+        Arc::new(history_cell::new_error_event("Failure remains visible.".into())),
+        Arc::from(history_cell::new_approval_decision_cell(
+            history_cell::ApprovalDecisionSubject::Command(vec!["approval-marker".into()]),
+            history_cell::ReviewDecision::Denied,history_cell::ApprovalDecisionActor::User)),
+    ];
+    while events.try_recv().is_ok() {}
+    let history_len=app.transcript_cells.len();
+    app.chat_widget.set_cmux_workers(Some(crate::cmux_orchestration::Counts { running:2,unread:1,needs_input:1,disconnected:0,..Default::default() }));
+    let mut tui=crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(true)?; let size=Size::new(100,24); tui.terminal.resize(size)?;
+    for _ in 0..2 {
+        app.render_owned_transcript(&mut tui,size)?;
+        let screen=buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal));
+        assert!(screen.contains("Assistant prose stays."),"{screen}");
+        assert!(screen.contains("Failure remains visible."),"{screen}");
+        assert!(screen.contains("approval-marker"),"{screen}");
+        assert_eq!(screen.contains("cmux workers · 2 running"),cfg!(feature="cmux-quiet"),"{screen}");
+        assert!(!screen.contains("Working"),"parent is idle: {screen}");
+        assert_eq!(app.transcript_cells.len(),history_len);
+        #[cfg(feature="cmux-quiet")] app.transcript_view.toggle_cmux_quiet();
+    }
+    // Row updates are local presentation, never an InsertHistoryCell or model op.
+    while let Ok(event)=events.try_recv() {
+        assert!(!matches!(event,AppEvent::InsertHistoryCell(_) | AppEvent::CodexOp(_)),"a passive row must not produce provider work or history");
+    }
+    let thread=app.chat_widget.thread_id().unwrap();
+    let started=serde_json::from_value(serde_json::json!({"method":"turn/started","params":{"threadId":thread.to_string(),"turn":{"id":"busy-turn","items":[],"itemsView":"full","status":"inProgress","error":null,"startedAt":null,"completedAt":null,"durationMs":0}}})).unwrap();
+    app.handle_thread_event_now(ThreadBufferedEvent::Notification(Box::new(started)));
+    app.render_owned_transcript(&mut tui,size)?;
+    let screen=buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal));
+    assert!(screen.contains("Working"),"{screen}");
+    assert_eq!(screen.contains("cmux workers · 2 running"),cfg!(feature="cmux-quiet"),"{screen}");
+    app.chat_widget.set_cmux_workers(Some(crate::cmux_orchestration::Counts { unavailable:true,..Default::default() }));
+    app.render_owned_transcript(&mut tui,size)?;
+    let screen=buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal));
+    assert_eq!(screen.contains("cmux workers · status unavailable"),cfg!(feature="cmux-quiet"),"{screen}");
+    assert!(!screen.contains("cmux workers · 2 running"));
+    assert_eq!(app.transcript_cells.len(),history_len);
+    app.chat_widget.set_cmux_workers(None); app.render_owned_transcript(&mut tui,size)?;
+    let screen=buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal));
+    assert!(!screen.contains("cmux workers"));
+    tui.set_owned_screen(false)?; Ok(())
+}
