+use super::*;
+use crate::app::owned_transcript::tests::{attach_thread, buffer_text};
+use codex_app_server_protocol::WebSearchAction;
+fn web()->Arc<dyn history_cell::HistoryCell> { Arc::new(history_cell::new_web_search_call("retained".into(),"LIVE_SUMMARY_NEEDLE".into(),WebSearchAction::Search {query:Some("LIVE_SUMMARY_NEEDLE".into()),queries:None})) }
+fn summaries(text:&str)->usize {text.lines().filter(|line|line.trim()=="• Activity").count()}
+fn active_web(app:&mut App, complete:bool) {
+    let thread=app.chat_widget.thread_id().unwrap().to_string();
+    let notification=serde_json::from_value(serde_json::json!({
+        "method":if complete {"item/completed"} else {"item/started"},
+        "params":{"threadId":thread,"turnId":"summary-turn", "startedAtMs":0,"completedAtMs":0,
+            "item":{"type":"webSearch","id":"active","query":"LIVE_SUMMARY_NEEDLE","action":{"type":"search","query":"LIVE_SUMMARY_NEEDLE","queries":null},"results":[]}}
+    })).unwrap();
+    app.chat_widget.handle_server_notification(notification,None);
+}
+#[tokio::test]
+async fn cmux_activity_summary_live_and_retained_share_one_row() -> Result<()> {
+    let (mut app,_events,_ops)=crate::app::tests::make_test_app_with_channels().await;
+    attach_thread(&mut app,ThreadId::new());app.local_settings.tui.animations=false;
+    let mut tui=crate::tui::test_support::make_test_tui()?;tui.set_owned_screen(true)?;tui.terminal.resize(Size::new(100,30))?; let size=Size::new(100,30);
+    // Actual live source, then a retained predecessor: no synthetic history mutation.
+    active_web(&mut app,false);
+    for retained in [false,true] {
+        if retained {app.transcript_cells.push(web());}
+        app.render_owned_transcript(&mut tui,size)?;
+        let screen=buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal));
+        assert_eq!(summaries(&screen),usize::from(cfg!(feature="cmux-quiet")),"{screen}");
+        if cfg!(feature="cmux-quiet") {assert!(!screen.contains("LIVE_SUMMARY_NEEDLE"),"{screen}");}
+    }
+    active_web(&mut app,true);app.render_owned_transcript(&mut tui,size)?;
+    let screen=buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal));assert_eq!(summaries(&screen),usize::from(cfg!(feature="cmux-quiet")),"{screen}");
+    assert_eq!(app.transcript_cells.len(),1);tui.set_owned_screen(false)?;Ok(())
+}
+#[tokio::test]
+async fn cmux_activity_summary_live_after_prose_starts_a_new_batch() -> Result<()> {
+    let (mut app,_events,_ops)=crate::app::tests::make_test_app_with_channels().await;
+    attach_thread(&mut app,ThreadId::new());app.local_settings.tui.animations=false;
+    let mut tui=crate::tui::test_support::make_test_tui()?;tui.set_owned_screen(true)?;tui.terminal.resize(Size::new(100,30))?;app.transcript_cells=vec![web(),Arc::new(history_cell::PlainHistoryCell::new(vec!["Progress prose".into()]))];
+    active_web(&mut app,false);
+    app.render_owned_transcript(&mut tui,Size::new(100,30))?;
+    let screen=buffer_text(crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal));assert_eq!(summaries(&screen),if cfg!(feature="cmux-quiet"){2}else{0},"{screen}");assert!(screen.contains("Progress prose"));
+    tui.set_owned_screen(false)?;Ok(())
+}
