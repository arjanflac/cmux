+
+    #[test]
+    fn cmux_quiet_retained_dynamic_status_refreshes_without_replacing_the_cell() {
+        let cell = Arc::new(
+            DynamicToolCallCell::from_item(dynamic_item(DynamicToolCallStatus::InProgress))
+                .unwrap(),
+        );
+        let cells = [cell.clone() as Arc<dyn HistoryCell>];
+        let mut view = TranscriptView::default();
+        render(&mut view, &cells, 100);
+        let active = view.layout(&cells, 0).unwrap();
+        assert!(active.text().contains("Calling"));
+        assert!(cell.update_from_item(dynamic_item(DynamicToolCallStatus::Failed)));
+        render(&mut view, &cells, 100);
+        let failed = view.layout(&cells, 0).unwrap();
+        assert!(failed.text().contains("Failed"));
+        assert!(!failed.text().contains(OUT));
+        assert_eq!(failed.text().lines().count(), 1);
+        assert!(!Arc::ptr_eq(&active, &failed));
+        assert!(Arc::ptr_eq(&(cell as Arc<dyn HistoryCell>), &cells[0]));
+    }
+
+    #[test]
+    fn cmux_quiet_unknown_attention_user_shell_and_nontext_results_keep_their_existing_display() {
+        #[derive(Debug)]
+        struct UnknownActivity;
+        impl HistoryCell for UnknownActivity {
+            fn display_lines(&self, _width: u16) -> Vec<Line<'static>> {
+                vec!["Unknown activity".into(), "Keep all of its payload.".into()]
+            }
+            fn raw_lines(&self) -> Vec<Line<'static>> {
+                self.display_lines(100)
+            }
+            fn activity_ids(&self) -> Vec<String> {
+                vec!["exec:unknown-future-cell".into()]
+            }
+        }
+        let mut cells: Vec<Arc<dyn HistoryCell>> = vec![
+            Arc::new(UnknownActivity),
+            Arc::new(PlainHistoryCell::new(vec![
+                "Assistant prose: Called a tool; Ran a command.".into(),
+                "Warning: attention must remain visible.".into(),
+            ])),
+            Arc::new(exec(Some(1), CommandExecutionSource::UserShell, false)),
+            Arc::new(exec(
+                Some(0),
+                CommandExecutionSource::UnifiedExecInteraction,
+                false,
+            )),
+            Arc::from(new_approval_decision_cell(
+                ApprovalDecisionSubject::Command(vec!["approval-marker".into()]),
+                ReviewDecision::Denied,
+                ApprovalDecisionActor::User,
+            )),
+            Arc::new(RequestUserInputResultCell {
+                questions: vec![ToolRequestUserInputQuestion {
+                    id: "question".into(),
+                    header: "Scope".into(),
+                    question: "Keep this question visible?".into(),
+                    is_other: false,
+                    is_secret: false,
+                    options: None,
+                }],
+                answers: Default::default(),
+                interrupted: false,
+            }),
+        ];
+        for block in [
+            json!({"type": "image", "data": "", "mimeType": "image/png"}),
+            json!({"type": "resource_link", "uri": "file:///artifact", "name": "artifact"}),
+            json!({"type": "futureArtifact", "value": "unknown-artifact"}),
+        ] {
+            let mut cell = mcp(None);
+            cell.complete(
+                Duration::from_millis(1),
+                Ok(serde_json::from_value(json!({"content": [block]})).unwrap()),
+            );
+            cells.push(Arc::new(cell));
+        }
+        for content in [
+            DynamicToolCallOutputContentItem::InputImage {
+                image_url: "data:image/png;base64,".into(),
+            },
+            DynamicToolCallOutputContentItem::InputAudio {
+                audio_url: "data:audio/wav;base64,".into(),
+            },
+        ] {
+            let mut item = dynamic_item(DynamicToolCallStatus::Completed);
+            if let ThreadItem::DynamicToolCall { content_items, .. } = &mut item {
+                *content_items = Some(vec![content]);
+            }
+            cells.push(Arc::new(DynamicToolCallCell::from_item(item).unwrap()));
+        }
+        for cell in cells {
+            let expected = TextLayout::new(cell.compact_hyperlink_lines(100), 100);
+            let mut view = TranscriptView::default();
+            let cells = [cell];
+            render(&mut view, &cells, 100);
+            assert_eq!(view.layout(&cells, 0).unwrap().text(), expected.text());
+        }
+    }
+}
